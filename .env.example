# ============================================================
# OmniAdmin — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local — it is gitignored.
# ============================================================

# ── Admin App's Own Supabase Project ──────────────────────────
# Create a brand-new Supabase project for admin auth only.
# Settings → API → Project URL / anon key / service_role key
NEXT_PUBLIC_ADMIN_SUPABASE_URL=https://your-admin-project.supabase.co
NEXT_PUBLIC_ADMIN_SUPABASE_ANON_KEY=your-admin-anon-key
ADMIN_SUPABASE_SERVICE_ROLE_KEY=your-admin-service-role-key

# ── Shudhham (Ayurveda e-commerce) ────────────────────────────
# Supabase: Settings → API
SHUDHHAM_SUPABASE_URL=https://alprilcknmklmacvtibr.supabase.co
SHUDHHAM_SUPABASE_SERVICE_ROLE_KEY=your-shudhham-service-role-key
# Stripe: Dashboard → Developers → API keys → Secret key
SHUDHHAM_STRIPE_SECRET_KEY=sk_live_your-shudhham-stripe-secret

# ── Houserve (Home-services app) ──────────────────────────────
# Supabase: Settings → API
HOUSERVE_SUPABASE_URL=https://wwnbbjvxrhjjwfshtxto.supabase.co
HOUSERVE_SUPABASE_SERVICE_ROLE_KEY=your-houserve-service-role-key
# Razorpay: Dashboard → Account & Settings → API Keys → Key Secret
HOUSERVE_RAZORPAY_KEY_SECRET=your-houserve-razorpay-secret

# ── BuildKart (Building-materials marketplace) ────────────────
# Supabase: Settings → API
BUILDKART_SUPABASE_URL=https://lydfhmfxjbimonjezwpu.supabase.co
BUILDKART_SUPABASE_SERVICE_ROLE_KEY=your-buildkart-service-role-key
# Razorpay: Dashboard → Account & Settings → API Keys → Key Secret
BUILDKART_RAZORPAY_KEY_SECRET=your-buildkart-razorpay-secret

# ── How to add a fourth project later ─────────────────────────
# 1. Add NEWPROJECT_SUPABASE_URL and NEWPROJECT_SUPABASE_SERVICE_ROLE_KEY here.
# 2. Create src/lib/supabase/newproject.ts (copy houserve.ts pattern).
# 3. Create src/integrations/newproject/ with types and query functions.
# 4. Add a new workspace entry in src/lib/workspace.ts.
# 5. Create src/app/(dashboard)/newproject/ pages.
# That's it — the sidebar and switcher pick it up automatically.
